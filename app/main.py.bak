import os, re
from datetime import datetime, timezone
from fastapi import FastAPI, Depends, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field
from sqlalchemy import create_engine, String, Text, Integer, ForeignKey, DateTime, select
from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column, relationship, sessionmaker, Session, joinedload

URL=os.getenv('DATABASE_URL','sqlite:///./verity.db')
engine=create_engine(URL,connect_args={'check_same_thread':False} if URL.startswith('sqlite') else {})
SessionLocal=sessionmaker(engine,autoflush=False,expire_on_commit=False)
class Base(DeclarativeBase): pass
class Brand(Base):
    __tablename__='brands'
    id:Mapped[int]=mapped_column(primary_key=True)
    name:Mapped[str]=mapped_column(String(180),unique=True,index=True)
    description:Mapped[str]=mapped_column(Text,default='')
class Rule(Base):
    __tablename__='rules'
    id:Mapped[int]=mapped_column(primary_key=True)
    brand_id:Mapped[int]=mapped_column(ForeignKey('brands.id'),index=True)
    kind:Mapped[str]=mapped_column(String(30))
    title:Mapped[str]=mapped_column(String(220))
    pattern:Mapped[str]=mapped_column(Text)
    severity:Mapped[str]=mapped_column(String(20),default='medium')
    explanation:Mapped[str]=mapped_column(Text)
    suggestion:Mapped[str]=mapped_column(Text,default='')
    source_note:Mapped[str]=mapped_column(Text,default='')
class Review(Base):
    __tablename__='reviews'
    id:Mapped[int]=mapped_column(primary_key=True)
    brand_id:Mapped[int]=mapped_column(ForeignKey('brands.id'))
    title:Mapped[str]=mapped_column(String(220))
    content:Mapped[str]=mapped_column(Text)
    status:Mapped[str]=mapped_column(String(40),default='needs_review')
    created_at:Mapped[datetime]=mapped_column(DateTime(timezone=True),default=lambda:datetime.now(timezone.utc))
    findings:Mapped[list['Finding']]=relationship(back_populates='review',cascade='all, delete-orphan',order_by='Finding.id')
class Finding(Base):
    __tablename__='findings'
    id:Mapped[int]=mapped_column(primary_key=True)
    review_id:Mapped[int]=mapped_column(ForeignKey('reviews.id'),index=True)
    rule_id:Mapped[int|None]=mapped_column(ForeignKey('rules.id'),nullable=True)
    rule_title:Mapped[str]=mapped_column(String(220))
    category:Mapped[str]=mapped_column(String(30))
    severity:Mapped[str]=mapped_column(String(20))
    title:Mapped[str]=mapped_column(String(220))
    description:Mapped[str]=mapped_column(Text)
    matched_text:Mapped[str]=mapped_column(Text,default='')
    evidence_status:Mapped[str]=mapped_column(String(30),default='unverified')
    evidence_reference:Mapped[str]=mapped_column(Text,default='')
    suggested_correction:Mapped[str]=mapped_column(Text,default='')
    decision_status:Mapped[str]=mapped_column(String(30),default='pending')
    review:Mapped['Review']=relationship(back_populates='findings')
class Decision(Base):
    __tablename__='decisions'
    id:Mapped[int]=mapped_column(primary_key=True)
    review_id:Mapped[int]=mapped_column(ForeignKey('reviews.id'))
    finding_id:Mapped[int]=mapped_column(ForeignKey('findings.id'))
    decision:Mapped[str]=mapped_column(String(30))
    created_at:Mapped[datetime]=mapped_column(DateTime(timezone=True),default=lambda:datetime.now(timezone.utc))

class BrandIn(BaseModel): name:str=Field(min_length=2,max_length=180); description:str=Field(default='',max_length=2000)
class RuleIn(BaseModel):
    kind:str; title:str=Field(min_length=2,max_length=220); pattern:str=Field(min_length=1,max_length=1000); severity:str='medium'; explanation:str=Field(min_length=3,max_length=4000); suggestion:str=''; source_note:str=''
class ReviewIn(BaseModel): brand_id:int; title:str='Untitled review'; content:str=Field(min_length=3,max_length=20000)
class DecisionIn(BaseModel): finding_id:int; decision:str
app=FastAPI(title='VERITY Brand Integrity API',version='1.0.0')
origins=[x.strip() for x in os.getenv('CORS_ORIGINS','http://localhost:5173,http://127.0.0.1:5500,null').split(',')]
app.add_middleware(CORSMiddleware,allow_origins=origins,allow_methods=['GET','POST','OPTIONS'],allow_headers=['*'])
Base.metadata.create_all(engine)
def db_dep():
    db=SessionLocal()
    try: yield db
    finally: db.close()
def run_engine(content,rules):
    out=[]
    for rule in rules:
        if rule.kind=='prohibited_phrase':
            for m in re.finditer(r'(?<!\\w)'+re.escape(rule.pattern)+r'(?!\\w)',content,re.I):
                out.append(dict(rule_id=rule.id,rule_title=rule.title,category=rule.kind,severity=rule.severity,title=rule.title,description=rule.explanation,matched_text=m.group(),evidence_status='contradicted',evidence_reference=rule.source_note or f'Configured rule #{rule.id}',suggested_correction=rule.suggestion,decision_status='pending'))
        elif rule.kind=='required_term' and not re.search(re.escape(rule.pattern),content,re.I):
            out.append(dict(rule_id=rule.id,rule_title=rule.title,category=rule.kind,severity=rule.severity,title=rule.title,description=rule.explanation,matched_text='',evidence_status='unverified',evidence_reference=rule.source_note or f'Configured rule #{rule.id}',suggested_correction=rule.suggestion or f'Include approved term: {rule.pattern}',decision_status='pending'))
        elif rule.kind=='fact_check' and rule.pattern.casefold() not in content.casefold():
            out.append(dict(rule_id=rule.id,rule_title=rule.title,category=rule.kind,severity=rule.severity,title=rule.title,description=rule.explanation,matched_text='',evidence_status='unverified',evidence_reference=rule.source_note or f'Approved fact record #{rule.id}',suggested_correction=rule.suggestion or f'Check against approved value: {rule.pattern}',decision_status='pending'))
    return out
def review_json(r):
    return {'id':r.id,'brand_id':r.brand_id,'title':r.title,'content':r.content,'status':r.status,'created_at':r.created_at.isoformat(),'findings':[{'id':f.id,'rule_id':f.rule_id,'rule_title':f.rule_title,'category':f.category,'severity':f.severity,'title':f.title,'description':f.description,'matched_text':f.matched_text,'evidence_status':f.evidence_status,'evidence_reference':f.evidence_reference,'suggested_correction':f.suggested_correction,'decision_status':f.decision_status} for f in r.findings]}
def calc_status(fs):
    p=[f for f in fs if f.decision_status=='pending']
    return 'changes_required' if any(f.severity in ('high','critical') for f in p) else ('needs_review' if p else 'ready_for_approval')
@app.get('/health')
def health(db:Session=Depends(db_dep)): db.execute(select(1)); return {'status':'ok','database':'connected'}
@app.get('/api/brands')
def brands(db:Session=Depends(db_dep)): return [{'id':b.id,'name':b.name,'description':b.description} for b in db.scalars(select(Brand).order_by(Brand.name)).all()]
@app.post('/api/brands',status_code=201)
def create_brand(d:BrandIn,db:Session=Depends(db_dep)):
    name=d.name.strip()
    if db.scalar(select(Brand).where(Brand.name==name)): raise HTTPException(409,'Brand already exists.')
    b=Brand(name=name,description=d.description.strip());db.add(b);db.commit();db.refresh(b);return {'id':b.id,'name':b.name,'description':b.description}
@app.get('/api/brands/{bid}/rules')
def list_rules(bid:int,db:Session=Depends(db_dep)):
    if not db.get(Brand,bid): raise HTTPException(404,'Brand not found.')
    return [{'id':r.id,'brand_id':r.brand_id,'kind':r.kind,'title':r.title,'pattern':r.pattern,'severity':r.severity,'explanation':r.explanation,'suggestion':r.suggestion,'source_note':r.source_note,'active':True} for r in db.scalars(select(Rule).where(Rule.brand_id==bid)).all()]
@app.post('/api/brands/{bid}/rules',status_code=201)
def add_rule(bid:int,d:RuleIn,db:Session=Depends(db_dep)):
    if not db.get(Brand,bid): raise HTTPException(404,'Brand not found.')
    if d.kind not in ('prohibited_phrase','required_term','fact_check'): raise HTTPException(422,'Unsupported rule type.')
    if d.severity not in ('low','medium','high','critical'): raise HTTPException(422,'Invalid severity.')
    if db.scalar(select(Rule).where(Rule.brand_id==bid,Rule.kind==d.kind,Rule.pattern==d.pattern)): raise HTTPException(409,'Rule already exists.')
    r=Rule(brand_id=bid,kind=d.kind,title=d.title.strip(),pattern=d.pattern.strip(),severity=d.severity,explanation=d.explanation.strip(),suggestion=d.suggestion.strip(),source_note=d.source_note.strip());db.add(r);db.commit();db.refresh(r)
    return {'id':r.id,'brand_id':r.brand_id,'kind':r.kind,'title':r.title,'pattern':r.pattern,'severity':r.severity,'explanation':r.explanation,'suggestion':r.suggestion,'source_note':r.source_note,'active':True}
@app.post('/api/reviews',status_code=201)
def create_review(d:ReviewIn,db:Session=Depends(db_dep)):
    if not db.get(Brand,d.brand_id): raise HTTPException(404,'Brand not found.')
    rules=db.scalars(select(Rule).where(Rule.brand_id==d.brand_id)).all();r=Review(brand_id=d.brand_id,title=d.title.strip() or 'Untitled review',content=d.content);db.add(r);db.flush()
    for f in run_engine(d.content,rules): db.add(Finding(review_id=r.id,**f))
    db.flush();r.status=calc_status(r.findings);db.commit();r=db.scalar(select(Review).options(joinedload(Review.findings)).where(Review.id==r.id));return review_json(r)
@app.get('/api/reviews')
def list_reviews(db:Session=Depends(db_dep)):
    rs=db.scalars(select(Review).options(joinedload(Review.findings)).order_by(Review.created_at.desc())).unique().all();return [review_json(r) for r in rs]
@app.get('/api/reviews/{rid}')
def get_review(rid:int,db:Session=Depends(db_dep)):
    r=db.scalar(select(Review).options(joinedload(Review.findings)).where(Review.id==rid))
    if not r: raise HTTPException(404,'Review not found.')
    return review_json(r)
@app.post('/api/reviews/{rid}/decisions')
def decide(rid:int,d:DecisionIn,db:Session=Depends(db_dep)):
    if d.decision not in ('accepted','rejected','resolved'): raise HTTPException(422,'Invalid decision.')
    r=db.scalar(select(Review).options(joinedload(Review.findings)).where(Review.id==rid))
    if not r: raise HTTPException(404,'Review not found.')
    f=next((x for x in r.findings if x.id==d.finding_id),None)
    if not f: raise HTTPException(404,'Finding not found in review.')
    f.decision_status=d.decision;db.add(Decision(review_id=r.id,finding_id=f.id,decision=d.decision));r.status=calc_status(r.findings);db.commit();r=db.scalar(select(Review).options(joinedload(Review.findings)).where(Review.id==rid));return review_json(r)
@app.get('/api/reviews/{rid}/passport')
def passport(rid:int,db:Session=Depends(db_dep)):
    r=db.scalar(select(Review).options(joinedload(Review.findings)).where(Review.id==rid))
    if not r: raise HTTPException(404,'Review not found.')
    return {'report_type':'VERITY Review Record','disclaimer':'This record documents checks against user-entered rules; it is not independent proof of factual truth.','review':review_json(r)}
